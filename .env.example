# ── localithelp.com.au (Local IT Help) — environment ─────────────────────────
# Copy to .env (git-ignored) and fill in. Every var is optional: the default
# noted in the comment is used when the line is missing or empty. The app loads
# .env from APP_DIR at startup; real environment variables take precedence.
# Note: comments must be on their own line (no trailing "# …" after a value).

# ── Server ───────────────────────────────────────────────────────────────────
# Listen port. Default: 8080
PORT=8080
# Directory holding .env and app.db. Default: .
APP_DIR=.
# Any non-empty value = production (BASE_URL default becomes https://localithelp.com.au)
PROD=
# Canonical origin for OAuth redirect + quote verification links.
# Default: https://localithelp.com.au if PROD, else http://localhost:PORT
BASE_URL=

# ── Site contact ─────────────────────────────────────────────────────────────
# Display phone. Default: empty (hides all phone UI)
PHONE=0481 344 099
# Contact email shown on the site. Also the SES sender ("Local IT Help <…>", must
# be a verified SES identity) and where booking / verified-quote notifications go.
# Default: james@localithelp.com.au
CONTACT_EMAIL=james@localithelp.com.au

# ── Pricing (AUD) ────────────────────────────────────────────────────────────
# Flat visit fee (includes travel). Default: 80
ONSITE_FEE=80
# Rate per 15-minute block. Default: 30
BLOCK_RATE=30
# Seniors Card discount, % off the total (0 hides it site-wide). Default: 20
SENIORS_DISCOUNT_PCT=20

# ── Invoices ─────────────────────────────────────────────────────────────────
# ABN printed on invoices. Default: 14 723 053 435
ABN=14 723 053 435
# Bank transfer details printed on invoices/emails. BSB empty = bank block hidden
# (customers then see only the Zeller payment link / pay-on-the-day).
BANK_ACCOUNT_NAME=James McHugh
BANK_BSB=
BANK_ACCOUNT_NO=

# ── Admin (Google sign-in) ───────────────────────────────────────────────────
# Google account allowed into /admin. Default: james67@gmail.com
ADMIN_EMAIL=james67@gmail.com
# Google OAuth client. Empty = sign-in disabled, /admin unreachable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Quote form ───────────────────────────────────────────────────────────────
# Anthropic API key for the AI estimate. Empty = estimate skipped.
ANTHROPIC_API_KEY=
# Cloudflare Turnstile bot check. Empty = check skipped (logged at startup).
# Dev test pair: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Google reviews ───────────────────────────────────────────────────────────
# Google Business Profile review link. In the Business Profile, choose
# "Ask for reviews" and copy the share link (https://g.page/r/…/review).
# Empty = /review, the QR card and the receipt-email review ask are all hidden.
REVIEW_URL=

# ── SEO ──────────────────────────────────────────────────────────────────────
# IndexNow key (bing.com/indexnow); served at /{key}.txt as the ownership
# proof for URL-submission pings. Empty = route disabled.
INDEXNOW_KEY=

# ── Email (Amazon SES) ───────────────────────────────────────────────────────
# scripts/ses-setup.sh creates the IAM user and prints these. Empty = email
# disabled (verification links are printed to the log — fine for local dev).
# Default region: ap-southeast-2
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
